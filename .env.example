# Local development: copy to `.env` and adjust.
# Production (GitHub Pages): the same names are read from
# GitHub -> Settings -> Secrets and variables -> Actions -> Variables.
# Everything below ends up on the public website, so never put secrets here.

SITE_URL=https://www.example.com
SITE_NAME=vselas Apps

# Product switches. A product that is switched off is completely hidden:
# no pages, navigation, sitemap entries, FAQ or assets.
# RoomTone is on unless ENABLE_ROOMTONE=false; the others are off unless "true".
ENABLE_ROOMTONE=true
ENABLE_EASY_CONTROL=false
ENABLE_HOMECONTROL_PLUS=false
ENABLE_ORCAMAIL=false

# Impressum / Datenschutz (required: NAME, STREET, POSTAL_CODE, CITY, EMAIL)
LEGAL_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_STREET=
LEGAL_ADDRESS_EXTRA=
LEGAL_POSTAL_CODE=
LEGAL_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_VAT_ID=
LEGAL_REGISTER_NAME=
LEGAL_REGISTER_NUMBER=
LEGAL_RESPONSIBLE_FOR_CONTENT=
PRIVACY_SUPERVISORY_AUTHORITY=Zustaendige Datenschutzaufsichtsbehoerde Ihres Bundeslandes
LEGAL_LAST_UPDATED=
